{
    "cli": {
        "version": ">= 16.0.0",
        "appVersionSource": "local"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "env": {
                "EXPO_PUBLIC_APP_ENV": "development"
            },
            "android": {
                "buildType": "apk"
            },
            "ios": {
                "simulator": true
            }
        },
        "preview": {
            "distribution": "internal",
            "env": {
                "NODE_ENV": "production",
                "EXPO_PUBLIC_APP_ENV": "production"
            },
            "android": {
                "buildType": "apk"
            },
            "ios": {
                "simulator": false,
                "resourceClass": "m-medium"
            }
        },
        "production": {
            "distribution": "store",
            "env": {
                "NODE_ENV": "production",
                "EXPO_PUBLIC_APP_ENV": "production"
            },
            "android": {
                "buildType": "app-bundle"
            },
            "ios": {
                "resourceClass": "m-medium",
                "autoIncrement": "buildNumber"
            }
        }
    },
    "submit": {
        "production": {}
    }
}
